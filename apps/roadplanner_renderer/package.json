{
  "name": "roadplanner-renderer-poc",
  "version": "0.8.0-journey.2",
  "private": true,
  "description": "Renderer app for Roadplanner. Remotion render in a slimmed image: headless shell, ffprobe only, multi-stage build.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.mjs",
  "scripts": {
    "start": "node src/index.mjs",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node --check src/index.mjs && node --check src/protocol.mjs && node --check src/render.mjs",
    "ensure-browser": "node scripts/ensure-browser.mjs"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.506",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.506",
    "@types/d3-geo": "3.1.1",
    "@types/react": "19.2.2",
    "@types/topojson-client": "3.1.5",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "2.0.2"
  }
}
